<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E293B"
    android:padding="16dp">

    <!-- Dialog Header -->
    <TextView
        android:id="@+id/tvFavoritesDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_favorites_title"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Address Search Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etAddressQuery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="@string/search_address_hint"
            android:textColorHint="#94A3B8"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="#0F172A"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSearchAddress"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/btn_search"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_nav"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Section Title -->
    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_saved_favorites"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- Scrollable Items Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#0F172A"
        android:padding="6dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/llFavoritesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/btnCloseFavDialog"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/map_btn_close"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_btn_item_action"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:textAllCaps="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp" />
</LinearLayout>
