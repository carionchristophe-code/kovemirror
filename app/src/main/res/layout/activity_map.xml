<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Adjustable Top Black Bar -->
    <View
        android:id="@+id/topBlackBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000" />

    <!-- Main Map Viewport Container -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0D0D0D">

        <!-- Full-screen OSM Map -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Full-screen 3D Map (MapLibre GL Native), shown when 3D layer is active -->
        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView3D"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Top bar: back + title + layer buttons + TFT frame fit button -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#CC0D0D0D"
            android:padding="6dp"
            android:elevation="6dp">

            <!-- Back button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="@string/map_btn_back"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="6dp" />

            <!-- Horizontally scrollable controls (settings + TFT + layers) so they fit the screen -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

            <!-- Map Settings Button (Theme & Cursor) -->
            <TextView
                android:id="@+id/btnMapSettings"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="⚙️"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#475569"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <!-- Layer Dropdown Menu -->
            <TextView
                android:id="@+id/btnLayerMenu"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🗺️ OSM Map ▼"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#2979FF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <!-- Layer: 3D -->
            <TextView
                android:id="@+id/btnLayer3D"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/map_layer_3d"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#555555"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true" />

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

    <!-- Top Turn Banner (Active during Navigation), US Highway Guide Sign Theme -->
    <LinearLayout
        android:id="@+id/navBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_highway_sign"
        android:padding="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="48dp"
        android:visibility="gone"
        android:layout_gravity="top"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTurnIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⬆️"
                android:textSize="28sp"
                android:gravity="center"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvTurnInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculating route..."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTurnDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="in 200 m"
                    android:textColor="#FCD34D"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStopNav"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/nav_stop"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="#DC2626"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- White Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66FFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <!-- Total Time & Remaining Time / Distance Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvInitialTotalDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total: -- min"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalDistanceEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining: -- min (0.0 km)"
                android:textColor="#FCD34D"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right side controls: Zoom + Location + GPS + Record + Import -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:layout_marginEnd="10dp">

        <!-- Zoom In -->
        <Button
            android:id="@+id/btnZoomIn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#CC333333"
            android:layout_marginBottom="4dp"
            android:elevation="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <!-- Zoom Out -->
        <Button
            android:id="@+id/btnZoomOut"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="−"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#CC333333"
            android:layout_marginBottom="8dp"
            android:elevation="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <!-- My Location (center on GPS) -->
        <Button
            android:id="@+id/btnMyLocation"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="◎"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#CC1565C0"
            android:layout_marginBottom="8dp"
            android:elevation="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <!-- GPS Toggle Button -->
        <Button
            android:id="@+id/btnGpsToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="📡"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#CC333333"
            android:layout_marginBottom="8dp"
            android:elevation="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <!-- Record Track Button -->
        <TextView
            android:id="@+id/btnRecordTrack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="●"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:background="#CC333333"
            android:gravity="center"
            android:includeFontPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp"
            android:elevation="4dp" />

        <!-- Import Route Button -->
        <Button
            android:id="@+id/btnImportRoute"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="📥"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#CC333333"
            android:elevation="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <!-- Favorites & Address Search Button -->
        <Button
            android:id="@+id/btnFavorites"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⭐"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#CC333333"
            android:elevation="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:layout_marginTop="8dp" />

        <!-- Toll Road Toggle Button (Shown only during active navigation) -->
        <Button
            android:id="@+id/btnTollToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="$"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#CC16A34A"
            android:elevation="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Loaded Routes List Button -->
        <Button
            android:id="@+id/btnRouteList"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="📋"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#1565C0"
            android:elevation="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom-Left Speedometer & Speed Limit Sign -->
    <LinearLayout
        android:id="@+id/gpsInfoCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_speedometer_card"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:elevation="8dp">

        <!-- European Speed Limit Sign (Red Circle with White Center) -->
        <FrameLayout
            android:id="@+id/layoutSpeedLimitSign"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_speed_limit_sign"
            android:layout_marginEnd="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSpeedLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="90"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </FrameLayout>

        <!-- Current Speed & Altitude Column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvGpsSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#38BDF8"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvGpsSpeedUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" km/h"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGpsAltitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--- m"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Destination Popup Bottom Card (When long-pressed on map) -->
    <LinearLayout
        android:id="@+id/destCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#F01E293B"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_destination_selected"
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDestCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:text="39.1234, 35.5678" />

        <TextView
            android:id="@+id/tvDestDist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:text="Approx: 12.4 km" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnCancelDest"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/map_btn_cancel"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="#475569"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSaveFavDest"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/btn_add_favorite"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="#D97706"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStartNav"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.5"
                android:text="@string/nav_start_navigation"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="#2563EB" />
        </LinearLayout>
    </LinearLayout>

    <!-- Route list bottom sheet (hidden by default) -->
    <LinearLayout
        android:id="@+id/routeListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E6111122"
        android:padding="8dp"
        android:visibility="gone"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map_loaded_routes"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearAllRoutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_clear_all_imported"
                android:textColor="#EF4444"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="#33EF4444"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/btnCloseRouteList"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@string/map_btn_close"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp">

            <LinearLayout
                android:id="@+id/routeListItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 3D diagnostics overlay (only visible in 3D mode, for debugging zoom/pitch/render) -->
    <TextView
        android:id="@+id/diag3d"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="50dp"
        android:layout_marginStart="6dp"
        android:background="#AA000000"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="" />

    </FrameLayout>

    <!-- Adjustable Bottom Black Bar -->
    <View
        android:id="@+id/bottomBlackBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000" />

</LinearLayout>
